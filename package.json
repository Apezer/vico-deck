{
  "name": "vico-keyboard",
  "version": "0.2.7",
  "description": "VicoDeck desktop companion for Vico Keyboard",
  "main": "electron/main.cjs",
  "author": "Vico",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "test": "node test/claude-monitor.test.cjs",
    "test:oled": "node test/oled-bitmap.test.mjs",
    "test:twin": "node test/twin-protocol.test.mjs",
    "test:profiles": "node test/profile-protocol.test.mjs",
    "test:runtime": "node test/runtime-protocol.test.mjs",
    "test:runtime-preview": "node test/oled-runtime-preview.test.mjs",
    "test:system": "node test/system-monitor.test.cjs",
    "test:ble": "node test/ble-reconnect.test.mjs",
    "test:voice": "node test/voice-protocol.test.mjs",
    "test:recorder": "node test/recorder-wav.test.mjs",
    "test:speech": "node --test test/doubao-service.test.cjs test/dashscope-provider.test.cjs test/speech-manager.test.cjs test/credential-store.test.cjs",
    "test:update": "node test/update-service.test.cjs",
    "test:firmware": "node test/firmware-service.test.cjs",
    "test:usb": "node test/usb-device.test.cjs",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "esptool-js": "^0.7.0",
    "spark-md5": "^3.0.2",
    "ws": "^8.18.3"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.vico.keyboard",
    "productName": "VicoDeck",
    "afterPack": "electron/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "firmware/**/*",
      "asserts/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "VicoDeck-Setup-${version}.${ext}",
      "icon": "asserts/vico-keyboard.ico",
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://update.zheng2005.xyz/"
      }
    ],
    "nsis": {
      "installerIcon": "asserts/vico-keyboard.ico",
      "uninstallerIcon": "asserts/vico-keyboard.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
