{
  "name": "vico-keyboard",
  "version": "0.2.0",
  "description": "Vico Keyboard desktop companion",
  "main": "electron/main.cjs",
  "author": "Vico",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "test": "node test/claude-monitor.test.cjs",
    "test:oled": "node test/oled-bitmap.test.mjs",
    "test:twin": "node test/twin-protocol.test.mjs",
    "test:profiles": "node test/profile-protocol.test.mjs",
    "test:runtime": "node test/runtime-protocol.test.mjs",
    "test:runtime-preview": "node test/oled-runtime-preview.test.mjs",
    "test:system": "node test/system-monitor.test.cjs",
    "test:ble": "node test/ble-reconnect.test.mjs",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.vico.keyboard",
    "productName": "Vico Keyboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "asserts/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "asserts/vico-keyboard.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "installerIcon": "asserts/vico-keyboard.ico",
      "uninstallerIcon": "asserts/vico-keyboard.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
